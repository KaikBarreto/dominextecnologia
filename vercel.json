{
  "redirects": [
    {
      "source": "/v1/docs",
      "destination": "/docs",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/sw-origin-guard.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://www.googletagmanager.com https://www.youtube.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:18181 https://*.supabase.co wss://*.supabase.co https://api.ipify.org https://brasilapi.com.br https://googleads.g.doubleclick.net https://nominatim.openstreetmap.org https://raw.githubusercontent.com https://router.project-osrm.org https://servicodados.ibge.gov.br https://tiles.dominex.app https://tiles.openfreemap.org https://viacep.com.br https://www.google.com https://www.google.com.br https://www.googleadservices.com https://www.googletagmanager.com; media-src 'self' blob: https:; frame-src 'self' blob: https:; child-src 'self' blob: https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/v1/openapi.json", "destination": "/api/openapi-v1" },
    { "source": "/v1/:path*", "destination": "/api/public-v1?path=:path*" },
    { "source": "/os-tecnico/:id", "destination": "/api/public-os?id=:id" },
    { "source": "/pagar/:ref", "destination": "/api/public-link?kind=pagar&ref=:ref&path=/pagar/:ref" },
    { "source": "/assinar/:ref", "destination": "/api/public-link?kind=assinar&ref=:ref&path=/assinar/:ref" },
    { "source": "/orcamento/:ref", "destination": "/api/public-link?kind=orcamento&ref=:ref&path=/orcamento/:ref" },
    { "source": "/proposta/:ref", "destination": "/api/public-link?kind=proposta&ref=:ref&path=/proposta/:ref" },
    { "source": "/portal/:ref", "destination": "/api/public-link?kind=portal&ref=:ref&path=/portal/:ref" },
    { "source": "/contrato/unidade/:ref", "destination": "/api/public-link?kind=contrato&ref=:ref&path=/contrato/unidade/:ref" },
    { "source": "/pmoc/unidade/:ref", "destination": "/api/public-link?kind=contrato&ref=:ref&path=/pmoc/unidade/:ref" },
    { "source": "/c/:ref", "destination": "/api/public-link?kind=certificado&ref=:ref&path=/c/:ref" },
    { "source": "/cadastro/:ref", "destination": "/api/public-link?kind=cadastro&ref=:ref&path=/cadastro/:ref" },
    { "source": "/ponto/empresa/:ref", "destination": "/api/public-link?kind=ponto_empresa&ref=:ref&path=/ponto/empresa/:ref" },
    { "source": "/ponto/:ref", "destination": "/api/public-link?kind=ponto&ref=:ref&path=/ponto/:ref" },
    { "source": "/ativar-ponto/:ref", "destination": "/api/public-link?kind=ativar_ponto&ref=:ref&path=/ativar-ponto/:ref" },
    { "source": "/cadastro-facial/:ref", "destination": "/api/public-link?kind=ativar_ponto&ref=:ref&path=/cadastro-facial/:ref" },
    { "source": "/avaliacao/:ref", "destination": "/api/public-link?kind=avaliacao&ref=:ref&path=/avaliacao/:ref" },
    { "source": "/blog/:slug", "destination": "/api/blog-post?slug=:slug&locale=pt-br" },
    { "source": "/en/blog/:slug", "destination": "/api/blog-post?slug=:slug&locale=en" },
    { "source": "/es/blog/:slug", "destination": "/api/blog-post?slug=:slug&locale=es" },
    { "source": "/fr/blog/:slug", "destination": "/api/blog-post?slug=:slug&locale=fr" },
    { "source": "/blog-sitemap.xml", "destination": "/api/blog-sitemap" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
