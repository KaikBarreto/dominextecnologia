# Copie para `.env` NO VPS e preencha. NUNCA commitar o .env real (gitignored).
# Gere valores fortes: `openssl rand -hex 32`.

# Chave global da Evolution API. A MESMA vai no secret EVOLUTION_API_KEY do Supabase.
EVOLUTION_API_KEY=

# Senha do Postgres interno da Evolution (não sai do VPS).
POSTGRES_PASSWORD=

# URL pública HTTPS da Evolution (atrás do proxy). Ex.: https://wa.suaempresa.com.br
# A MESMA vai no secret EVOLUTION_API_URL do Supabase.
EVOLUTION_SERVER_URL=
