# =============================================================================
# MODELO de /etc/dominex-fiscal/service.env  —  ⚠️ ARQUIVO DE SEGREDO
# =============================================================================
# ⚠️ ESTE ARQUIVO É SÓ UM MODELO. O de verdade:
#   - mora em /etc/dominex-fiscal/service.env NA VPS
#   - NUNCA entra no git, no repo, na imagem Docker, em snapshot versionado
#   - é `chown root:deploy` + `chmod 0640` (o `deploy` precisa ler pro
#     `docker compose up`; ele já tem sudo NOPASSWD, então não é degradação)
#
# Gere os valores com os comandos do RUNBOOK §1.4. Não invente, não reaproveite
# de outro ambiente, não copie de mensagem de chat.
# =============================================================================

# Segredo compartilhado com as Edge Functions da Supabase (mesmo valor dos dois
# lados). Gere com:  openssl rand -hex 48
FISCAL_SERVICE_TOKEN=

# Token ANTERIOR — preenchido só durante a rotação (RUNBOOK §3.2) e esvaziado
# depois. Aceitar os dois ao mesmo tempo é o que evita janela de erro.
FISCAL_SERVICE_TOKEN_PREV=

# Anel de KEK — a chave que protege os certificados dos clientes.
# Formato: "id:base64[,id:base64]".  A PRIMEIRA da lista é a ATUAL (sela material
# novo); as demais só abrem envelopes antigos. É isso que permite rotacionar sem
# pedir re-upload de certificado a ninguém.
#   1 KEK:            FISCAL_KEKS=1:<base64 de 32 bytes>
#   durante rotação:  FISCAL_KEKS=2:<base64 novo>,1:<base64 antigo>
# Gere cada uma com:  openssl rand -base64 32
#
# ⚠️⚠️ GUARDE CÓPIA DE CADA KEK NO GERENCIADOR DE SENHAS. Perder a KEK torna
# TODOS os certificados de cliente indecifráveis — cada cliente teria que subir o
# dele de novo. O snapshot da Hostinger não cobre isso (mora na mesma conta).
FISCAL_KEKS=
