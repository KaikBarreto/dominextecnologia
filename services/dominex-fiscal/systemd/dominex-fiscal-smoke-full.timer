[Unit]
Description=dominex-fiscal — emissao de fumaca diaria em HOMOLOGACAO

[Timer]
# 07:10 BR: cedo o bastante pra ter o dia inteiro pra corrigir antes de o cliente
# precisar faturar, e tarde o bastante pra alguém estar acordado pra ler o alerta.
# (O fuso da VPS já é America/Sao_Paulo — Fase 1 do RUNBOOK da Evolution.)
OnCalendar=*-*-* 07:10:00
Persistent=true
RandomizedDelaySec=300
AccuracySec=1m

[Install]
WantedBy=timers.target
