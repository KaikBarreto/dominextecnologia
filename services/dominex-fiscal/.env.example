# =============================================================================
# .env do dominex-fiscal — copie para .env NA VPS.
# =============================================================================
# ⚠️ NÃO existe segredo neste arquivo, e não pode passar a existir.
# Token e KEK vivem em /etc/dominex-fiscal/service.env (root:deploy, 0640),
# fora do repo. Ver RUNBOOK §1.4 e service.env.example.
#
#   cp .env.example .env && chmod 600 .env
# =============================================================================

# Arquivo de dependências usado no build.
# Primeiro build: requirements.txt. Depois de gerar o lock: requirements.lock.txt.
REQ_FILE=requirements.txt

# Timeout (s) da chamada ao governo. O POST /nfse é síncrono.
FISCAL_HTTP_TIMEOUT=90

# Identificação do emissor no XML (campo verAplic da DPS).
FISCAL_VER_APLIC=Dominex-1.0

# ⚠️ Produção x homologação NÃO se configura aqui. O ambiente (1 = produção,
# 2 = homologação) vem no corpo de cada requisição — não existe chave global que
# alguém possa virar sem querer.
